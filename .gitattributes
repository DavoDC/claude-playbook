# Normalise all text to LF in the repository. Without this, a checkout on a
# second OS rewrites every line ending and the whole tree reads as modified,
# which makes `git diff` useless as a review tool and breaks any
# commit-anchored delta audit over this repo.
* text=auto eol=lf

# Windows-only scripts must keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.gif binary
