#!/bin/sh
# Blocks staged content that references a private sibling repo.
#
# Generic and safe to publish: no repo name or path is hardcoded here. Any
# sibling repo opts INTO this protection by dropping a `.private-root` marker
# file at its own root (see docs/12-privacy-hooks-public-repo.md for the marker
# format). This hook globs for those
# markers under the parent of this repo and derives its token list from what
# it finds - so the list is different on every machine, and this file never
# needs editing to stay accurate.
#
# Install: run hooks/install.sh once after cloning.

GH_ROOT="${GH_ROOT:-$(dirname "$(git rev-parse --show-toplevel)")}"

# Generic layer first: user paths, emails, IPs, internal hostnames, and the
# per-machine private-terms file. It runs even when no .private-root marker exists.
sh "$(dirname "$0")/privacy-scan.sh" staged || exit 1

# Commit identity: refuse an author or committer email that is not an allowlisted noreply address
# (hooks/author-allowlist.txt). There is deliberately no override switch.
sh "$(dirname "$0")/privacy-scan.sh" author || exit 1

PATTERN=""
for t in $(
    for marker in "$GH_ROOT"/*/.private-root; do
        [ -f "$marker" ] || continue
        repo_dir=$(dirname "$marker")
        basename "$repo_dir"
        first_line=$(grep -v '^#' "$marker" | grep -v '^[[:space:]]*$' | head -1)
        [ -n "$first_line" ] && echo "$first_line" | cut -d/ -f1
    done | sort -u
); do
    [ -z "$t" ] && continue
    if [ -z "$PATTERN" ]; then
        PATTERN="$t"
    else
        PATTERN="$PATTERN|$t"
    fi
done

[ -z "$PATTERN" ] && exit 0

# Report WHERE, never WHAT. Echoing the offending line would print the very
# private token this hook exists to contain - into the terminal, into any
# CI log, and into the transcript of an assistant that commits on your
# behalf. A file list is enough to act on, and costs nothing if it leaks.
#
# The name list is NUL-delimited (-z) and read one name per line, so a file name with a space
# is scanned as one file, not split into pieces that match nothing.
NAMELIST=$(mktemp)
git diff --cached --name-only -z | tr '\0' '\n' > "$NAMELIST"
FILES=$(while IFS= read -r f; do
    [ -n "$f" ] || continue
    if git diff --cached -U0 -- ":(literal)$f" | grep "^+" | grep -v "^+++" | grep -Eqi "$PATTERN"; then
        echo "  $f"
    fi
done < "$NAMELIST")
rm -f "$NAMELIST"

if [ -n "$FILES" ]; then
    echo ""
    echo "ERROR: staged content matches a token derived from a local .private-root marker."
    echo "This repo may be public - private sibling-repo names/paths must not appear in it."
    echo "Use generic language, or move this content into the private repo instead."
    echo ""
    echo "Affected file(s) - the matched token is withheld deliberately, so that"
    echo "this message is safe to paste anywhere:"
    echo "$FILES"
    echo ""
    exit 1
fi

exit 0
