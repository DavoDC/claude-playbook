#!/bin/sh
# Last gate before commits leave the machine: runs the history scan over the commits being pushed
# (the new commits only, so it stays fast) and refuses the push on any hit. Catches what a
# --no-verify commit or a commit made outside the hooks let through. Safe to publish: no private
# term is hardcoded; see hooks/privacy-scan.sh.
#
# Git passes the remote name and URL as arguments and one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

remote="$1"
ZERO=0000000000000000000000000000000000000000
here=$(dirname "$0")
status=0

while read -r _ lsha _ rsha; do
    [ -n "$lsha" ] || continue
    [ "$lsha" = "$ZERO" ] && continue   # deleting a ref sends no commits
    if [ "$rsha" != "$ZERO" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
        sh "$here/privacy-scan.sh" history "$lsha" --not "$rsha" || status=1
    else
        # New ref, or the remote tip is not known locally: everything not already on this remote.
        sh "$here/privacy-scan.sh" history "$lsha" --not --remotes="$remote" || status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: the privacy scan hit in the commits being pushed; push refused." >&2
fi
exit "$status"
